# Supabase — copia in .env.local e riempi con i valori del tuo progetto (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Anti-frode: sale per l'hash dell'IP (stringa lunga e casuale, tienila segreta)
IP_SALT=cambia-questo-con-una-stringa-casuale-lunga

# Cloudflare Turnstile (anti-bot). Crea un widget su https://dash.cloudflare.com → Turnstile
# Se lasci vuoto, la protezione Turnstile resta disattivata e i form funzionano lo stesso.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
